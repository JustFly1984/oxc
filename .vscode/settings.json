{
  // "oxc.path.goatlint": "apps/goatlint/dist/cli.js", // debug with local goatlint build
  "oxc.typeAware": true,
  "oxc.configPath": "goatlintrc.json",
  "oxc.unusedDisableDirectives": "deny",
  // "oxc.path.goatfmt": "apps/goatfmt/dist/cli.js", // debug with local goatfmt build
  "oxc.fmt.configPath": "goatfmtrc.jsonc",
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file", // goatfmt can only format whole files
  "editor.codeActionsOnSave": {
    "source.organizeImports": "never" // let goatfmt handle import organization
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  }
}
