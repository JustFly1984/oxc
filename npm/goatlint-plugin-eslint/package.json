{
  "name": "goatlint-plugin-eslint",
  "version": "1.61.0",
  "description": "ESLint's built-in rules as a Goatlint plugin",
  "keywords": [
    "eslint",
    "linter",
    "goatlint",
    "plugin"
  ],
  "homepage": "https://github.com/JustFly1984/oxc",
  "bugs": "https://github.com/JustFly1984/oxc/issues",
  "license": "MIT",
  "author": "Alexey Lyakhov (fork of oxc by Boshen and contributors)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JustFly1984/oxc",
    "directory": "npm/goatlint-plugin-eslint"
  },
  "funding": {
    "url": "https://github.com/sponsors/JustFly1984"
  },
  "files": [
    "index.js",
    "rules",
    "common",
    "README.md"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    }
  },
  "scripts": {
    "prepublishOnly": "cd ../../apps/goatlint && bun run build-js && cp -r dist-pkg-plugin-eslint/. ../../npm/goatlint-plugin-eslint/",
    "pub": "bun publish .",
    "pub:next": "bun publish . --tag next"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
