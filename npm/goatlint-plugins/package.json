{
  "name": "@goatlint/plugins",
  "version": "1.59.0",
  "description": "Plugin utilities for Oxlint",
  "keywords": [
    "eslint",
    "linter",
    "goatlint",
    "plugin"
  ],
  "homepage": "https://goatlint.dev/docs/guide/usage/linter/js-plugins",
  "bugs": "https://github.com/goat-project/oxc/issues",
  "license": "MIT",
  "author": "Boshen and oxc contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goat-project/oxc.git",
    "directory": "npm/goatlint-plugins"
  },
  "funding": {
    "url": "https://github.com/sponsors/Boshen"
  },
  "files": [
    "index.js",
    "index.cjs",
    "index.d.ts",
    "README.md"
  ],
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs",
      "default": "./index.js"
    }
  },
  "scripts": {
    "prepublishOnly": "cd ../../apps/goatlint && pnpm run build-js && cp dist-pkg-plugins/* ../../npm/goatlint-plugins/",
    "pub": "npm publish .",
    "pub:next": "npm publish . --tag next"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^12.22.0 || ^14.17.0 || >=16.0.0"
  }
}
