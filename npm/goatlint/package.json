{
  "name": "goatlint",
  "version": "1.60.0",
  "description": "A fast JavaScript/TypeScript linter - fork of oxlint with additional rules",
  "keywords": [
    "eslint",
    "javascript",
    "linter",
    "goat",
    "goatlint",
    "typescript"
  ],
  "homepage": "https://github.com/JustFly1984/oxc",
  "bugs": "https://github.com/JustFly1984/oxc/issues",
  "license": "MIT",
  "author": "Alexey Lyakhov (fork of oxc by Boshen and contributors)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JustFly1984/oxc",
    "directory": "npm/goatlint"
  },
  "bin": {
    "goatlint": "bin/goatlint"
  },
  "files": [
    "configuration_schema.json",
    "dist",
    "README.md",
    "bin/goatlint"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugins-dev": {
      "types": "./dist/plugins-dev.d.ts",
      "default": "./dist/plugins-dev.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {},
  "peerDependenciesMeta": {},
  "napi": {
    "binaryName": "goatlint",
    "packageName": "@goatlint/binding",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "i686-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "armv7-unknown-linux-gnueabihf",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "armv7-unknown-linux-musleabihf",
      "aarch64-linux-android",
      "armv7-linux-androideabi",
      "aarch64-unknown-linux-ohos",
      "x86_64-unknown-freebsd",
      "powerpc64le-unknown-linux-gnu",
      "riscv64gc-unknown-linux-gnu",
      "riscv64gc-unknown-linux-musl",
      "s390x-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "prebuild": "cd ../../apps/goatlint && bun run build",
    "prepublishOnly": "rm -f dist && cp -r ../../apps/goatlint/dist .",
    "postpublish": "rm -rf dist && ln -s ../../apps/goatlint/dist dist",
    "pub": "npm publish",
    "pub:next": "npm publish --tag next"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "preferUnplugged": true
}
