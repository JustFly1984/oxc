{
  "name": "goatlint",
  "version": "1.59.0",
  "description": "Linter for the JavaScript Oxidation Compiler",
  "keywords": [
    "eslint",
    "javascript",
    "linter",
    "goat",
    "goatlint",
    "typescript"
  ],
  "homepage": "https://goatlint.dev/docs/guide/usage/linter",
  "bugs": "https://github.com/goat-project/oxc/issues",
  "license": "MIT",
  "author": "Boshen and oxc contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goat-project/oxc",
    "directory": "npm/goatlint"
  },
  "funding": {
    "url": "https://github.com/sponsors/Boshen"
  },
  "bin": {
    "goatlint": "bin/goatlint"
  },
  "files": [
    "configuration_schema.json",
    "dist",
    "README.md",
    "bin/goatlint"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugins-dev": {
      "types": "./dist/plugins-dev.d.ts",
      "default": "./dist/plugins-dev.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "goatlint-tsgolint": ">=0.18.0"
  },
  "peerDependenciesMeta": {
    "goatlint-tsgolint": {
      "optional": true
    }
  },
  "napi": {
    "binaryName": "goatlint",
    "packageName": "@goatlint/binding",
    "targets": [
      "aarch64-apple-darwin",
      "aarch64-linux-android",
      "aarch64-pc-windows-msvc",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "aarch64-unknown-linux-ohos",
      "armv7-linux-androideabi",
      "armv7-unknown-linux-gnueabihf",
      "armv7-unknown-linux-musleabihf",
      "i686-pc-windows-msvc",
      "powerpc64le-unknown-linux-gnu",
      "riscv64gc-unknown-linux-gnu",
      "riscv64gc-unknown-linux-musl",
      "s390x-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-freebsd",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl"
    ]
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "preferUnplugged": true
}
